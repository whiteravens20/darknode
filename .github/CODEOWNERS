# ── Code Owners ──────────────────────────────────────────────────────────────
# Auto-requests review from the listed owner on any pull request touching
# these paths, and says where a mistake costs most.
#
# Do NOT turn on "Require review from Code Owners" in branch protection on a
# solo repo. Nobody can approve their own pull request, so that setting
# together with enforce_admins makes every pull request unmergeable. The merge
# gate here is CI.
#
# Paths are checked most-specific to least-specific; the last match wins.

# Anything that changes how a build runs or what it pulls in.
/.github/ @pavlojs
/Dockerfile @pavlojs
/docker-compose.yml @pavlojs
/go.mod @pavlojs
/go.sum @pavlojs
/web/package.json @pavlojs
/web/package-lock.json @pavlojs

# Who gets in, and as whom. A mistake here is an account somebody else's.
/internal/auth/ @pavlojs
/internal/server/session.go @pavlojs
/internal/server/handlers_register.go @pavlojs
/internal/server/handlers_login.go @pavlojs

# The shape of the stored data, and every change to it. A migration that is
# wrong is wrong in everyone's database at once.
/internal/store/ @pavlojs

# Legal notices and licence.
/LICENSE @pavlojs
/NOTICE @pavlojs
/SECURITY.md @pavlojs
/internal/legal/ @pavlojs
