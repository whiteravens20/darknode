# Copy this file to .env and read the comments. The two secrets do not live
# here: they are files under secrets/, so they stay out of the environment
# and out of `docker inspect`.
#
#   mkdir -p secrets
#   openssl rand -base64 32 > secrets/db_password
#   openssl rand -base64 48 > secrets/server_secret
#   chmod 600 secrets/*
#
# The server secret keys the HMACs of recovery and invite codes. Change it and
# every code already handed out stops working, so keep it and back it up with
# the database.

# Which image tag to run. `main` is the newest release.
DARKNODE_VERSION=main

# The port on the loopback address the game is published on.
DARKNODE_PORT=8080

# Who may make an account: open, invite or closed.
# With `invite`, make codes with:  docker compose exec game /darknode invite -n 5
DARKNODE_REGISTRATION=open

# Leave true wherever a browser reaches the game over HTTPS. Set it to false
# only for a local instance over plain HTTP, where a Secure cookie is dropped.
DARKNODE_COOKIE_SECURE=true

# The networks of the proxies whose X-Forwarded-For header may be believed,
# comma separated. Anything else is ignored, so a visitor cannot claim an
# address that is not theirs. Leave it empty when nothing sits in front.
# Example: 172.18.0.0/16,10.0.0.5
DARKNODE_TRUSTED_PROXIES=

# debug, info, warn or error.
DARKNODE_LOG_LEVEL=info
